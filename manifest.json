{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Manga Translator BYOK",
  "version": "3.0.0",
  "description": "Translate manga images with your own vision API and local text rendering.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "scripts/background.js", "type": "module"},
  "action": {"default_popup": "popup/popup.html", "default_title": "Manga Translator BYOK"},
  "options_page": "popup/settings.html",
  "icons": {"16": "images/16.png", "48": "images/48.png", "128": "images/128.png"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["scripts/render.js", "scripts/content.js"]}],
  "commands": {"translate-image": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Translate hovered image"}},
  "web_accessible_resources": [{"resources": ["fonts/NotoSans.ttf", "fonts/WildWords.otf"], "matches": ["http://*/*", "https://*/*"]}]
}
